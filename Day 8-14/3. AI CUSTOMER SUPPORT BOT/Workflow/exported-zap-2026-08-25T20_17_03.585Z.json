            "authentication_id": "0",
            "model_id": "standard/auto",
            "isOutputArray": false,
            "instructions": "Classify this CloudFlow customer support issue into exactly one priority.\r\n\r\nRules:\r\n\r\nCritical = The system is completely down, the whole service is unavailable, or there is a severe system-wide outage.\r\n\r\nHigh = The customer cannot access their account or cannot log in.\r\n\r\nMedium = A normal technical problem or customer question that requires support but is not urgent.\r\n\r\nLow = A general request, suggestion, feedback, or other non-urgent request.\r\n\r\nReturn ONLY one of these exact words:\r\n\r\nCritical\r\nHigh\r\nMedium\r\nLow\r\n\r\nCustomer issue:\r\n{{=output[\"377537383\"][\"new\"][\"data\"][\"f11\"]}}",
            "outputFields": [
              {
                "name": "Customer Issue",
                "description": "The specific problem or issue described by the customer that needs to be classified into a priority level.",
                "type": "text",
                "isRequired": true
              },
              {
                "name": "Priority Level",
                "description": "The classification of the customer support issue based on its urgency and impact.",
                "type": "category_single",
                "isRequired": true,
                "options": [
                  "Critical",
                  "High",
                  "Medium",
                  "Low"
                ]
              }
            ]
          },
          "meta": {
