        "2": {
          "id": 2,
          "paused": true,
          "type_of": "write",
          "params": {
            "packages_enabled": false,
            "input": {
              "employee_name": "{{=output[\"377435123\"][\"values\"][\"cmt71vxlz000a356v5wdsi818\"]}}",
              "employee_email": "{{=output[\"377435123\"][\"values\"][\"cmt71vxlz000b356vx9960dbk\"]}}",
              "department": "{{=output[\"377435123\"][\"values\"][\"cmt71vxlz000c356v7oqfan2e\"]}}",
              "expense_type": "{{=output[\"377435123\"][\"values\"][\"cmt71vxm0000d356vpuo2rab9\"]}}",
              "amount": "{{=output[\"377435123\"][\"values\"][\"cmt71vxm0000e356v0tupwl86\"]}}",
              "expense_date": "{{=output[\"377435123\"][\"values\"][\"cmt71vxm0000f356vccieza6y\"]}}",
              "description": "{{=output[\"377435123\"][\"values\"][\"cmt71vxm0000g356vy0809sdk\"]}}",
              "receipt": "{{=output[\"377435123\"][\"values\"][\"cmt71vxm1000h356vppf55o4q\"]}}",
              "manager_email": "{{=output[\"377435123\"][\"values\"][\"cmt71vxm1000i356v5qzgxr5f\"]}}"
            },
            "code": "function cleanText(value) {\n  if (value === undefined || value === null) {\n    return '';\n  }\n\n  return String(value).trim();\n}\n\n// -----------------------------\n// Read form values\n// -----------------------------\n\nconst employeeName = cleanText(inputData.employee_name);\nconst employeeEmail = cleanText(inputData.employee_email).toLowerCase();\nconst department = cleanText(inputData.department);\nconst expenseType = cleanText(inputData.expense_type);\nconst expenseDate = cleanText(inputData.expense_date);\nconst description = cleanText(inputData.description);\nconst managerEmail = cleanText(inputData.manager_email).toLowerCase();\n\n\n// -----------------------------\n// Clean Amount\n// -----------------------------\n\nconst rawAmount = String(inputData.amount || '')\n  .replace(/[^0-9.]/g, '');\n\nconst amount = parseFloat(rawAmount) || 0;\n\n\n// -----------------------------\n// Detect missing receipt\n// -----------------------------\n\nconst receipt = cleanText(inputData.receipt);\n\nconst receiptMissing =\n  receipt === '' ||\n  receipt.toLowerCase() === 'null' ||\n  receipt.toLowerCase() === 'none' ||\n  receipt.toLowerCase() === 'undefined';\n\n\n// -----------------------------\n// Determine Risk Level\n// -----------------------------\n//\n// Low    = amount < 100\n// Medium = 100 to 500\n// High   = above 500\n//\n\nlet riskLevel;\n\nif (amount < 100) {\n  riskLevel = 'Low';\n\n} else if (amount <= 500) {\n  riskLevel = 'Medium';\n\n} else {\n  riskLevel = 'High';\n}\n\n\n// -----------------------------\n// Determine Approval Status\n// -----------------------------\n//\n// Missing receipt overrides\n// all other approval logic.\n//\n\nlet approvalStatus;\n\nif (receiptMissing) {\n\n  approvalStatus = 'Receipt Required';\n\n} else if (riskLevel === 'Low') {\n\n  approvalStatus = 'Approved';\n\n} else {\n\n  approvalStatus = 'Pending';\n}\n\n\n// -----------------------------\n// Generate Request ID\n// -----------------------------\n//\n// Example:\n// EXP-4821\n//\n\nconst randomNumber =\n  Math.floor(1000 + Math.random() * 9000);\n\nconst requestId =\n  `EXP-${randomNumber}`;\n\n\n// Submitted At\nconst submittedAt = new Date().toISOString();\n\n// -----------------------------\n// Clean Output\n// -----------------------------\n\noutput = {\n\n  request_id: requestId,\n\n  employee_name: employeeName,\n\n  employee_email: employeeEmail,\n\n  department: department,\n\n  expense_type: expenseType,\n\n  amount: amount,\n\n  expense_date: expenseDate,\n\n  description: description,\n\n  receipt: receipt,\n\n  receipt_missing: receiptMissing,\n\n  manager_email: managerEmail,\n\n  risk_level: riskLevel,\n\n  approval_status: approvalStatus,\n\n  submitted_at: submittedAt\n};"
          },
