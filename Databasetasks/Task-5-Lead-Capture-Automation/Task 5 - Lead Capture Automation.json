        "query": "UPDATE leads\nSET sync_status = 'synced'\nWHERE lead_uuid = $1\nRETURNING\n    id,\n    lead_uuid,\n    name,\n    email,\n    phone,\n    company,\n    message,\n    source,\n    sync_status,\n    created_at;",
