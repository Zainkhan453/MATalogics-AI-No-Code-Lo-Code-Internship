              }
            }
          ]
        },
        "options": {}
      },
      "id": "8d6a0967-a340-40e5-83a4-661ee5332a0e",
      "name": "Lead Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        672,
