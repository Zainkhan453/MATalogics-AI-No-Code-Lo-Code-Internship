    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO leads (\n  name, email, phone, company, message, source,\n  lead_score, lead_status, lead_category, qualification_reason,\n  ai_analyzed_at, sync_status, created_at, updated_at\n)\nVALUES ($1, $2, $3, $4, $5, $6, NULL, 'Pending', NULL, NULL, NULL, 'pending', NOW(), NOW())\nRETURNING id, lead_uuid, name, email, phone, company, message, source,\n  lead_score, lead_status, lead_category, qualification_reason,\n  ai_analyzed_at, sync_status, created_at, updated_at;",
        "options": {
          "queryReplacement": "={{ [$json.name, $json.email, $json.phone, $json.company, $json.message, $json.source] }}"
        }
      },
      "id": "52549381-0a5a-41c2-b1dc-28f0333ea0dc",
      "name": "PostgreSQL - Insert Original Lead",
      "type": "n8n-nodes-base.postgres",
