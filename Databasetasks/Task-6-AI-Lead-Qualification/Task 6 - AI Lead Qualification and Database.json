    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ai = $json.output || $json;\nconst lead = $(\"PostgreSQL - Insert Original Lead\").item.json;\n\nlet score = parseInt(ai.lead_score, 10);\nif (isNaN(score)) { score = 0; }\nif (score < 0) { score = 0; }\nif (score > 100) { score = 100; }\n\nlet status, category;\nif (score >= 70) { status = 'Qualified'; category = 'High Intent'; }\nelse if (score >= 40) { status = 'Nurture'; category = 'Medium Intent'; }\nelse { status = 'Unqualified'; category = 'Low Intent'; }\n\nreturn {\n  id: lead.id,\n  lead_uuid: lead.lead_uuid,\n  name: lead.name,\n  email: lead.email,\n  phone: lead.phone,\n  company: lead.company,\n  message: lead.message,\n  source: lead.source,\n  lead_score: score,\n  lead_status: status,\n  lead_category: category,\n  qualification_reason: ai.qualification_reason || '',\n};"
      },
