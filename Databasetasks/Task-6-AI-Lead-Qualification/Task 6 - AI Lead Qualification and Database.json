      "id": "b1fda123-13cf-442e-8098-413213f3bd6b",
      "name": "Normalize Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
        208
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json;\nconst required = ['name', 'email', 'phone', 'company', 'message', 'source'];\nlet error = null;\nfor (const field of required) {\n  const value = data[field] == null ? '' : String(data[field]).trim();\n  if (value === \"\") { error = field.charAt(0).toUpperCase() + field.slice(1) + \" is required\"; break; }\n}\nif (!error) {\n  const email = String(data.email).trim();\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n  if (!emailRegex.test(email)) { error = 'Valid email is required'; }\n}\nreturn {\n  name: data.name,\n  email: data.email,\n  phone: data.phone,\n  company: data.company,\n  message: data.message,\n  source: data.source,\n  is_valid: error === null,\n  validation_error: error,\n};"
      },
