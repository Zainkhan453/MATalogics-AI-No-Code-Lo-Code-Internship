        "jsCode": "const conv = ($input.first() && $input.first().json) ? $input.first().json : {};\nconst cust = $('Normalize Customer').first().json;\nreturn [{ json: {\n  conversation_id: conv.id,\n  conversation_uuid: conv.conversation_uuid,\n  status: conv.status,\n  started_at: conv.started_at,\n  last_message_at: conv.last_message_at,\n  conversation_created_at: conv.created_at,\n  conversation_updated_at: conv.updated_at,\n  customer_id: cust.customer_id,\n  customer_uuid: cust.customer_uuid,\n  customer_name: cust.customer_name,\n  customer_email: cust.customer_email,\n  customer_phone: cust.customer_phone,\n  customer_created_at: cust.customer_created_at,\n  customer_updated_at: cust.customer_updated_at,\n  message: cust.message,\n} }];"
