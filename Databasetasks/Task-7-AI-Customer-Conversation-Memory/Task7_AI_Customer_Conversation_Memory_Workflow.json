      "parameters": {
        "jsCode": "const items = $input.all();\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nreturn items.map((it) => {\n  const src = (it.json && it.json.body) ? it.json.body : (it.json || {});\n  const email = (src.email == null ? '' : String(src.email)).trim().toLowerCase();\n  const message = (src.message == null ? '' : String(src.message)).trim();\n  const name = (src.name == null ? '' : String(src.name)).trim();\n  const phone = (src.phone == null ? '' : String(src.phone)).trim();\n  let isValid = true;\n  let error = null;\n  if (!email) { isValid = false; error = 'Valid email is required'; }\n  else if (!emailRegex.test(email)) { isValid = false; error = 'Valid email is required'; }\n  else if (!message) { isValid = false; error = 'Message is required'; }\n  return { json: {\n    name: name || null,\n    email: email,\n    phone: phone || null,\n    message: message,\n    isValid: isValid,\n    error: error,\n  } };\n});"
      },
