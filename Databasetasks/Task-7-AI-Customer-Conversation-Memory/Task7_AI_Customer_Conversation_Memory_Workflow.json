      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT sender_type, message_text, created_at\nFROM (\n  SELECT sender_type, message_text, created_at\n  FROM messages\n  WHERE conversation_id = $1\n  ORDER BY created_at DESC\n  LIMIT 20\n) recent_messages\nORDER BY created_at ASC;",
